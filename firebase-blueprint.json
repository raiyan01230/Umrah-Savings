{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and targets",
      "type": "object",
      "properties": {
        "goalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "language": { "type": "string", "enum": ["en", "bn"] }
      },
      "required": ["goalAmount", "currency", "theme", "language"]
    },
    "SavingsEntry": {
      "title": "SavingsEntry",
      "description": "A financial entry for daily savings, extra money, or expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "day": { "type": "string" },
        "dailyMoney": { "type": "number" },
        "extraMoney": { "type": "number" },
        "source": { "type": "string" },
        "expense": { "type": "number" },
        "todaySavings": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "day", "dailyMoney", "extraMoney", "expense", "todaySavings"]
    },
    "IslamicQuote": {
      "title": "IslamicQuote",
      "description": "A Quranic verse or Sahih Hadith for motivation",
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "bn": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["en", "bn", "source"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User root document storing profile and settings"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "SavingsEntry",
      "description": "Subcollection of daily saving, expense, and gift entries"
    },
    "/quotes/{quoteId}": {
      "schema": "IslamicQuote",
      "description": "A global collection of Quranic verses and Hadiths for daily inspiration"
    }
  }
}
